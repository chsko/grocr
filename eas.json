{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://silent-otter-909.eu-west-1.convex.cloud"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_CONVEX_URL": "https://silent-otter-909.eu-west-1.convex.cloud"
      },
      "channel": "main"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production"
    }
  },
  "submit": {
    "production": {},
    "preview": {}
  }
}
