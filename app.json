{
  "expo": {
    "name": "Grocr",
    "slug": "grocr",
    "owner": "wolub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grocr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.grocr.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.grocr.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6DC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "nb": "./src/lib/i18n/locales/native/nb.json",
      "en": "./src/lib/i18n/locales/native/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6DC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#17130F",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "597e5728-3ace-4f42-9a7a-3199f175b48e"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/597e5728-3ace-4f42-9a7a-3199f175b48e"
    }
  }
}
